<%@ Master Language="C#" MasterPageFile="~/Dashboard.Master" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="Project_Board.Admin.AdminMaster" %>

<asp:Content ID="Content1" ContentPlaceHolderID="TitleContent" runat="server">
    <asp:ContentPlaceHolder ID="TitleContent" runat="server">Admin Dashboard</asp:ContentPlaceHolder>
</asp:Content>

<asp:Content ID="Content2" ContentPlaceHolderID="HeadContent" runat="server">
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</asp:Content>

<asp:Content ID="Content3" ContentPlaceHolderID="SidebarNav" runat="server">
    <div class="nav-section">
        <div class="nav-section-title">Main Menu</div>
        <a href='<%= ResolveUrl("~/Admin/Admin_Dashboard.aspx") %>' class='nav-link <%= Request.Url.AbsolutePath.EndsWith("Admin_Dashboard.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>
            <i class="fa-solid fa-chart-pie"></i> <span>Overview</span>
        </a>
        <a href='<%= ResolveUrl("~/Admin/Admin_Analysis.aspx") %>' class='nav-link <%= Request.Url.AbsolutePath.EndsWith("Admin_Analysis.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>
            <i class="fa-solid fa-chart-line"></i> <span>Analysis & Reports</span>
        </a>
        <a href='<%= ResolveUrl("~/Admin/Admin_UserManagement.aspx") %>' class='nav-link <%= Request.Url.AbsolutePath.EndsWith("Admin_UserManagement.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>
            <i class="fa-solid fa-users"></i> <span>Users Management</span>
        </a>
        <a href='<%= ResolveUrl("~/Admin/Admin_GroupsManagement.aspx") %>' class='nav-link <%= Request.Url.AbsolutePath.EndsWith("Admin_GroupsManagement.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>
            <i class="fa-solid fa-user-group"></i> <span>Groups</span>
        </a>
        <a href='<%= ResolveUrl("~/Admin/Admin_ProjectsManagement.aspx") %>' class='nav-link <%= Request.Url.AbsolutePath.EndsWith("Admin_ProjectsManagement.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>
            <i class="fa-solid fa-folder-open"></i> <span>Projects</span>
        </a>
        <a href='<%= ResolveUrl("~/Admin/Admin_TechManagement.aspx") %>' class='nav-link <%= Request.Url.AbsolutePath.EndsWith("Admin_TechManagement.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>
            <i class="fa-solid fa-microchip"></i> <span>Technologies</span>
        </a>
        <a href='<%= ResolveUrl("~/Admin/Admin_TaskManagement.aspx") %>' class='nav-link <%= Request.Url.AbsolutePath.EndsWith("Admin_TaskManagement.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>'>
            <i class="fa-solid fa-list-check"></i> <span>Tasks</span>
        </a>
    </div>

    <div class="nav-section">
        <div class="nav-section-title">Preferences</div>
        <a href='<%= ResolveUrl("~/User/Profile.aspx") %>' class="nav-link">
            <i class="fa-solid fa-user"></i> <span>Profile</span>
        </a>
        <a href='<%= ResolveUrl("~/Logout.aspx") %>' class="nav-link">
            <i class="fa-solid fa-arrow-right-from-bracket"></i> <span>Logout</span>
        </a>
    </div>
</asp:Content>

<asp:Content ID="Content4" ContentPlaceHolderID="MainContent" runat="server">
    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
</asp:Content>

<asp:Content ID="Content5" ContentPlaceHolderID="ScriptsContent" runat="server">
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</asp:Content>
